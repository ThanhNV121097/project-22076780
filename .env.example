# Compose-level overrides for docker-compose.yml. All optional; defaults
# shown are what docker-compose.yml itself falls back to.

# Host port the frontend container's nginx is published on.
FRONTEND_PORT=3000

# Memory ceiling for the frontend container.
FRONTEND_MEM_LIMIT=768m

# Set by .github/workflows/publish.yml when pushing a built image; a local
# clone needs neither and falls back to a local build.
IMAGE_REPO=local
IMAGE_TAG=dev
